#: core/ai_chat.py
msgid "AI chat is not configured yet."
msgstr "Lisolo na AI ebongisami naino te."

#: core/ai_chat.py
msgid "Message request is too large."
msgstr "Bosengi ya nsango ezali monene mingi."

#: core/ai_chat.py
msgid "Invalid message format."
msgstr "Lolenge ya nsango ezali malamu te."

#: core/ai_chat.py
msgid "Please enter a message."
msgstr "Svp, koma nsango."

#: core/ai_chat.py
msgid "Please keep messages under 2000 characters."
msgstr "Svp, nsango ezala na bilembo koleka 2000 te."

#: core/ai_chat.py
msgid "Invalid conversation ID."
msgstr "Nimero ya lisolo ezali malamu te."

#: core/ai_chat.py
msgid "Conversation not found."
msgstr "Lisolo ezwami te."

#: core/ai_chat.py
msgid "Message limit reached. Please try again later."
msgstr "Okómi na ndelo ya bansango. Meka lisusu na nsima."

#: core/ai_chat.py
msgid "AI model configuration is invalid."
msgstr "Bobongisi ya modèle ya AI ezali malamu te."

#: core/ai_chat.py
msgid "The assistant could not generate a reply."
msgstr "Mosungi akoki kopesa eyano te."

#: core/ai_chat.py
msgid "AI is busy. Please try again shortly."
msgstr "AI ezali na mosala mingi. Meka lisusu mwa moke na nsima."

#: core/ai_chat.py
msgid "AI service is temporarily unavailable."
msgstr "Service ya AI ezali kosala te mpo na mwa ntango."

#: core/ai_chat.py
msgid "Could not connect to the AI service."
msgstr "Tokoki kokangama na service ya AI te."
