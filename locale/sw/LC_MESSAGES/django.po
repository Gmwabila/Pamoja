#: core/templates/core/welcome.html:8
msgid "YOUR LIFE, A LITTLE MORE TOGETHER"
msgstr "MAISHA YAKO, YENYE MPANGILIO ZAIDI"

#: core/templates/core/welcome.html:12
msgid "Big plans.<br>Small steps.<br><em>Together.</em>"
msgstr "Mipango mikubwa.<br>Hatua ndogo.<br><em>Pamoja.</em>"

#: core/templates/core/welcome.html:16
msgid ""
"A little clarity for your everyday. Make room for your goals, organize what "
"matters, and find your next step with PAMOJA."
msgstr ""
"Uwazi kidogo katika maisha yako ya kila siku. Tenga nafasi kwa malengo yako, "
"panga mambo muhimu na pata hatua yako inayofuata kwa PAMOJA."

#: core/templates/core/welcome.html:20
msgid "Find your rhythm"
msgstr "Pata mdundo wako"

#: core/templates/core/welcome.html:25
msgid "Your own space. Your own pace."
msgstr "Nafasi yako mwenyewe. Kwa kasi yako mwenyewe."

#: core/templates/core/welcome.html:34
msgid "together."
msgstr "pamoja."

#: core/templates/core/welcome.html:39
msgid "Make time for you"
msgstr "Tenga muda kwa ajili yako"

#: core/templates/core/welcome.html:44
msgid "One step forward"
msgstr "Hatua moja mbele"

#: core/templates/core/welcome.html:48
msgid "A little structure.<br>A lot of possibility."
msgstr "Mpangilio kidogo.<br>Uwezekano mwingi."

#: core/templates/core/welcome.html:56
msgid "ROOTED IN TOGETHERNESS"
msgstr "MSINGI WETU NI UMOJA"

#: core/templates/core/welcome.html:59
msgid "A space that feels like yours."
msgstr "Nafasi inayokufaa."

#: core/templates/core/welcome.html:62
msgid ""
"In Swahili, <strong>pamoja</strong> means <strong>together</strong>. That’s "
"the idea behind everything we’re building."
msgstr ""
"Katika Kiswahili, <strong>pamoja</strong> humaanisha kuwa <strong>kwa "
"pamoja</strong>. Hilo ndilo wazo linaloongoza kila tunachojenga."

#: core/templates/core/welcome.html:70
msgid "See what matters"
msgstr "Ona mambo muhimu"

#: core/templates/core/welcome.html:72
msgid "Your day, your priorities, one clear view."
msgstr "Siku yako na vipaumbele vyako, katika mwonekano mmoja ulio wazi."

#: core/templates/core/welcome.html:80
msgid "Make it personal"
msgstr "Ifanye ikufae"

#: core/templates/core/welcome.html:90
msgid "Keep moving forward"
msgstr "Endelea kusonga mbele"

#: core/templates/core/welcome.html:92
msgid "Track small wins that add up over time."
msgstr "Fuatilia mafanikio madogo yanayoongezeka kadiri muda unavyopita."

#: core/templates/core/welcome.html:100
msgid ""
"Early development build · Planning and accounts work now. Live AI is a "
"future milestone."
msgstr ""
"Toleo linaloendelezwa · Mipango na akaunti tayari vinafanya kazi. AI ya moja "
"kwa moja itaongezwa baadaye."

#: core/templates/registration/login.html:5
msgid "Welcome back"
msgstr "Karibu tena"

#: core/templates/registration/login.html:16
msgid "A little more<br><em>together.</em>"
msgstr "Kwa umoja zaidi<br><em>pamoja.</em>"

#: core/templates/registration/login.html:20
msgid "Pick up where you left off. Your plans will be right here."
msgstr "Endelea ulipoishia. Mipango yako itakuwa hapa."

#: core/templates/registration/login.html:25
msgid "One step at a time."
msgstr "Hatua moja baada ya nyingine."

#: core/templates/registration/login.html:30
msgid "GOOD TO SEE YOU"
msgstr "TUNAFURAHI KUKUONA"

#: core/templates/registration/login.html:33
msgid "Welcome back."
msgstr "Karibu tena."

#: core/templates/registration/login.html:36
msgid "Log in to your PAMOJA account."
msgstr "Ingia kwenye akaunti yako ya PAMOJA."

#: core/templates/registration/login.html:47
msgid "Let’s continue"
msgstr "Tuendelee"

#: core/templates/registration/login.html:53
msgid "New here?"
msgstr "Wewe ni mgeni hapa?"

#: core/templates/registration/login.html:55
msgid "Create an account"
msgstr "Fungua akaunti"

#: core/templates/registration/signup.html:5
msgid "Create your account"
msgstr "Fungua akaunti yako"

#: core/templates/registration/signup.html:12
msgid "A FRESH START"
msgstr "MWANZO MPYA"

#: core/templates/registration/signup.html:16
msgid "Your next chapter<br>starts <em>here.</em>"
msgstr "Ukurasa wako mpya<br>unaanza <em>hapa.</em>"

#: core/templates/registration/signup.html:20
msgid "You bring the goals. We’ll build a little space to bring them together."
msgstr "Unaleta malengo yako. Tunajenga nafasi ya kuyaweka pamoja."

#: core/templates/registration/signup.html:26
msgid "Together, every step of the way."
msgstr "Pamoja, katika kila hatua."

#: core/templates/registration/signup.html:32
msgid "WELCOME TO PAMOJA"
msgstr "KARIBU PAMOJA"

#: core/templates/registration/signup.html:35
msgid "Let’s get you settled."
msgstr "Tuandae nafasi yako."

#: core/templates/registration/signup.html:38
msgid "Create your personal account."
msgstr "Fungua akaunti yako binafsi."

#: core/templates/registration/signup.html:46
msgid "Create my account"
msgstr "Fungua akaunti yangu"

#: core/templates/registration/signup.html:52
msgid "Email verification and password recovery are not available yet."
msgstr ""
"Uthibitishaji wa barua pepe na urejeshaji wa nenosiri bado havipatikani."

#: core/templates/registration/signup.html:56
msgid "Already have an account?"
msgstr "Tayari una akaunti?"

#: core/time_fields.py:7 core/time_fields.py:59
msgid "Hour"
msgstr "Saa"

#: core/time_fields.py:12 core/time_fields.py:60
msgid "Minute"
msgstr "Dakika"

#: core/time_fields.py:18
msgid "AM/PM"
msgstr "AM/PM"

#: core/time_fields.py:61
msgid "AM or PM"
msgstr "AM au PM"

#: core/time_fields.py:79
msgid "Choose an hour, minute, and AM or PM, or leave all three blank."
msgstr "Chagua saa, dakika na AM au PM, au acha sehemu zote tatu wazi."

#: core/time_fields.py:97
msgid ""
"Optional. For 6:30 PM, choose 6, 30, and PM. Leave all three blank for no "
"time."
msgstr ""
"Si lazima. Kwa saa 6:30 PM, chagua 6, 30 na PM. Acha sehemu zote tatu wazi "
"ikiwa hutaki kuweka muda."

#: core/views.py:59
msgid "Your space is ready. Let’s take the next step together."
msgstr "Nafasi yako iko tayari. Tuchukue hatua inayofuata pamoja."

#: core/views.py:81
msgid "Good morning"
msgstr "Habari za asubuhi"

#: core/views.py:83
msgid "Good afternoon"
msgstr "Habari za mchana"

#: core/views.py:85
msgid "Good evening"
msgstr "Habari za jioni"

