#: core/ai_chat.py
msgid "AI chat is not configured yet."
msgstr "Gumzo la AI bado halijasanidiwa."

#: core/ai_chat.py
msgid "Message request is too large."
msgstr "Ombi la ujumbe ni kubwa mno."

#: core/ai_chat.py
msgid "Invalid message format."
msgstr "Muundo wa ujumbe si sahihi."

#: core/ai_chat.py
msgid "Please enter a message."
msgstr "Tafadhali andika ujumbe."

#: core/ai_chat.py
msgid "Please keep messages under 2000 characters."
msgstr "Tafadhali hakikisha ujumbe una herufi chini ya 2000."

#: core/ai_chat.py
msgid "Invalid conversation ID."
msgstr "Kitambulisho cha mazungumzo si sahihi."

#: core/ai_chat.py
msgid "Conversation not found."
msgstr "Mazungumzo hayajapatikana."

#: core/ai_chat.py
msgid "Message limit reached. Please try again later."
msgstr "Umefikia kikomo cha ujumbe. Tafadhali jaribu tena baadaye."

#: core/ai_chat.py
msgid "AI model configuration is invalid."
msgstr "Mipangilio ya modeli ya AI si sahihi."

#: core/ai_chat.py
msgid "The assistant could not generate a reply."
msgstr "Msaidizi hakuweza kutoa jibu."

#: core/ai_chat.py
msgid "AI is busy. Please try again shortly."
msgstr "AI ina shughuli nyingi. Tafadhali jaribu tena baada ya muda mfupi."

#: core/ai_chat.py
msgid "AI service is temporarily unavailable."
msgstr "Huduma ya AI haipatikani kwa sasa."

#: core/ai_chat.py
msgid "Could not connect to the AI service."
msgstr "Imeshindikana kuunganisha kwenye huduma ya AI."
